{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "gitCommit", "generatedAt", "protocolVersion", "compatibleProtocolVersions", "images"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/v2-release/v1" },
    "version": { "type": "string", "minLength": 1 },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "protocolVersion": { "const": 1 },
    "compatibleProtocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": 1 }
    },
    "images": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {
            "enum": ["agentx-migrate", "agentx-bootstrap", "agentx-doctor", "platform-control", "web-console", "runtime-gateway", "workflow-runtime", "workflow-worker", "sandbox-manager", "observability"]
          },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
