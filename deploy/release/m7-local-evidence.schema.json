{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/m7-local-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "generatedAt", "environment", "registry", "trustScope", "isolationLevel", "int009", "int011", "int012", "int014", "m7", "failure", "junit", "evidence"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/m7-local-evidence/v1" },
    "status": { "enum": ["passed", "failed"] },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "environment": { "const": "local-docker-desktop" },
    "registry": { "const": "local-tls" },
    "trustScope": { "const": "local-only" },
    "isolationLevel": { "const": "standard" },
    "int009": { "enum": ["passed", "failed"] },
    "int011": { "enum": ["passed", "failed"] },
    "int012": { "const": "in_progress" },
    "int014": { "const": "in_progress" },
    "m7": { "const": "in_progress" },
    "failure": { "type": ["string", "null"] },
    "junit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "failures", "errors", "skipped", "path"],
      "properties": {
        "tests": { "type": "integer", "minimum": 1 },
        "failures": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "skipped": { "const": 0 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": {
        "properties": {
          "int009": { "const": "passed" },
          "int011": { "const": "passed" },
          "failure": { "type": "null" },
          "junit": { "properties": { "failures": { "const": 0 }, "errors": { "const": 0 } } }
        }
      }
    }
  ]
}
