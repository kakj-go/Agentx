{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/supply-chain-negative-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "generatedAt", "assertions"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/supply-chain-negative-evidence/v1" },
    "status": { "const": "passed" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assertions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
