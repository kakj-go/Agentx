{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/release-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "gitCommit", "generatedAt", "isolationLevel", "runtimeClass", "images"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/release/v1" },
    "version": { "type": "string", "minLength": 1 },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "isolationLevel": { "enum": ["standard", "strong"] },
    "runtimeClass": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference", "digest", "sbom", "sbomSha256", "signatureVerified"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "sbom": { "type": "string", "minLength": 1 },
          "sbomSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signatureVerified": { "const": true }
        }
      }
    }
  }
}
