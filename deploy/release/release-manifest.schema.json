{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/release-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "gitCommit", "generatedAt", "isolationLevel", "runtimeClass", "images"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/release/v1" },
    "version": { "type": "string", "minLength": 1 },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "isolationLevel": { "enum": ["standard", "strong"] },
    "runtimeClass": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference", "digest", "sbom", "sbomSha256", "sbomCanonicalSha256", "predicateType", "signatureVerified", "attestationVerified"],
        "properties": {
          "name": {
            "enum": [
              "platform-api",
              "trigger-gateway",
              "workflow-coordinator",
              "workflow-worker",
              "sandbox-manager",
              "trace-writer",
              "web"
            ]
          },
          "reference": { "type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "sbom": { "type": "string", "minLength": 1 },
          "sbomSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sbomCanonicalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "predicateType": { "type": "string", "pattern": "[Cc]yclone" },
          "signatureVerified": { "const": true },
          "attestationVerified": { "const": true }
        }
      },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "platform-api" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "trigger-gateway" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "workflow-coordinator" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "workflow-worker" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "sandbox-manager" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "trace-writer" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "name": { "const": "web" } }, "required": ["name"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  }
}
