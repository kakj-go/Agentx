{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/m7-acceptance-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "generatedAt", "isolationLevel", "runtimeClass", "junit", "evidence"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/m7-acceptance-evidence/v1" },
    "status": { "const": "passed" },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "isolationLevel": { "enum": ["standard", "strong"] },
    "runtimeClass": { "type": "string", "minLength": 1 },
    "junit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "tests", "failures", "errors", "skipped"],
      "properties": {
        "files": { "type": "integer", "minimum": 1 },
        "tests": { "type": "integer", "minimum": 1 },
        "failures": { "const": 0 },
        "errors": { "const": 0 },
        "skipped": { "const": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
