{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentx.local/schemas/vault-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "image", "endpoint", "kvMount", "rotationVerified", "oldVersionDestroyed", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "agentx.io/vault-evidence/v1" },
    "status": { "const": "passed" },
    "runId": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
    "endpoint": { "type": "string", "minLength": 1 },
    "kvMount": { "type": "string", "minLength": 1 },
    "rotationVerified": { "const": true },
    "oldVersionDestroyed": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
