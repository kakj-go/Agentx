{
  "apiVersion": "agentx.io/deployment/v1alpha1",
  "namespace": "agentx",
  "environment": "production",
  "images": {
    "mode": "registry",
    "registry": "registry.example.com/agentx",
    "tag": "0.1.0",
    "pullPolicy": "IfNotPresent",
    "digests": {
      "web": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform-api": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "trigger-gateway": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "workflow-coordinator": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "workflow-worker": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "sandbox-manager": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "trace-writer": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    }
  },
  "network": { "allowedEgressCidrs": ["10.20.0.0/16", "2001:db8:20::/64"] },
  "ingress": {
    "host": "agentx.example.com",
    "controllerServiceType": "LoadBalancer",
    "tlsSecretName": "agentx-web-tls"
  },
  "secrets": { "mode": "existing", "provider": "vault_kv_v2", "vaultAddress": "https://vault.example.internal", "vaultMount": "agentx", "name": "agentx-secrets", "vaultName": "agentx-vault-secrets", "lightragName": "agentx-lightrag-secrets", "mem0Name": "agentx-mem0-secrets" },
  "components": {
    "mysql": { "mode": "external", "host": "mysql.example.internal", "port": 3306, "database": "agentx", "user": "agentx", "tlsMode": "verify_identity", "tls": { "caFile": "C:/secure/mysql-ca.pem" } },
    "redis": { "mode": "external", "url": "rediss://redis.example.internal:6379/", "tls": { "caFile": "C:/secure/redis-ca.pem" } },
    "clickhouse": { "mode": "external", "url": "https://clickhouse.example.internal:8443", "database": "agentx", "user": "agentx", "tls": { "caFile": "C:/secure/clickhouse-ca.pem" } },
    "objectStorage": { "mode": "external-s3", "endpoint": "https://s3.example.com", "bucket": "agentx-artifacts", "region": "us-east-1", "allowHttp": false, "pathStyle": false, "tls": {} },
    "rag": { "mode": "external", "endpoint": "https://rag.example.internal" },
    "memory": { "mode": "disabled", "endpoint": null },
    "sandbox": { "mode": "remote", "runtimeClass": "runc", "runtimeClassName": null, "isolationLevel": "standard", "isolationEvidence": null, "endpoint": "https://sandbox.example.internal", "secureAccess": true, "useServerProxy": true, "allowedHosts": ["sandbox.example.internal"], "allowedCidrs": [] }
  }
}
