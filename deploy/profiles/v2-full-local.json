{
  "apiVersion": "agentx.io/deployment/v2alpha2",
  "environment": "local",
  "namespaces": {
    "control": "agentx-v2-control",
    "runtime": "agentx-v2-runtime",
    "dependencies": "agentx-v2-deps"
  },
  "images": { "registry": "agentx", "tag": "dev", "pullPolicy": "IfNotPresent" },
  "ingress": { "className": "agentx-nginx", "controlHost": "agentx.localhost", "runtimeHost": "run.agentx.localhost", "controlTlsSecretName": null, "runtimeTlsSecretName": null },
  "services": {
    "webConsole": { "replicas": 1, "maxReplicas": 4 },
    "platformControl": { "replicas": 1, "maxReplicas": 4, "roles": ["api", "publisher", "projector", "retention"], "mysqlPool": 10 },
    "runtimeGateway": { "replicas": 1, "maxReplicas": 4, "mysqlPool": 8 },
    "workflowRuntime": { "replicas": 1, "maxReplicas": 4, "roles": ["coordinator", "trigger", "command", "outbox", "recovery", "artifact", "quota", "trace-relay"], "mysqlPool": 10 },
    "workflowWorker": { "replicas": 1, "maxReplicas": 4, "capability": "all", "mysqlPool": 6 },
    "sandboxManager": { "replicas": 1, "maxReplicas": 4, "mysqlPool": 2 },
    "observability": { "replicas": 1, "maxReplicas": 4, "roles": ["trace-consumer", "query"] }
  },
  "components": {
    "controlMysql": { "mode": "bundled", "host": "control-mysql.agentx-v2-control.svc", "port": 3306, "database": "agentx_control", "appUser": "control_app", "migrateUser": "control_migrate", "tlsMode": "disabled", "maxConnections": 60, "serverMaxConnections": 151 },
    "runtimeMysql": { "mode": "bundled", "host": "runtime-mysql.agentx-v2-runtime.svc", "port": 3306, "database": "agentx_runtime", "appUser": "runtime_app", "migrateUser": "runtime_migrate", "tlsMode": "disabled", "maxConnections": 105, "serverMaxConnections": 151 },
    "runtimeRedis": { "mode": "bundled", "url": "redis://runtime-redis.agentx-v2-runtime.svc:6379/" },
    "secretProvider": { "mode": "vault_kv_v2", "endpoint": "http://vault.agentx-v2-deps.svc:8200", "mount": "secret" },
    "sandbox": { "mode": "external_opensandbox", "endpoint": "http://opensandbox.agentx-v2-deps.svc:8080", "secureAccess": false },
    "clickhouse": { "mode": "bundled", "url": "http://clickhouse.agentx-v2-runtime.svc:8123", "database": "agentx_observability", "queryUser": "observability_query", "consumerUser": "observability_consumer", "migrateUser": "observability_migrate" },
    "objectStorage": {
      "mode": "bundled-minio", "endpoint": "http://object-storage.agentx-v2-deps.svc:9000", "region": "us-east-1", "allowHttp": true, "pathStyle": true,
      "domains": {
        "control": { "bucket": "agentx-control", "user": "control_object" },
        "runtime": { "bucket": "agentx-runtime", "user": "runtime_object" },
        "observability": { "bucket": "agentx-observability", "user": "observability_object" }
      }
    }
  },
  "secrets": {
    "mode": "generated-local",
    "control": "agentx-control-secrets",
    "runtime": "agentx-runtime-secrets",
    "observability": "agentx-observability-secrets",
    "dependencies": "agentx-dependencies-secrets"
  }
}
