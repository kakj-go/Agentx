{
  "name": "agentx-canvas-plugin-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
