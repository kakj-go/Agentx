{
  "protocolVersion": "3.0",
  "nodeType": "acme.json_mapper",
  "version": 1,
  "displayName": "JSON Mapper",
  "description": "Adds a configured label to every input item.",
  "category": "transform",
  "keywords": ["json", "map", "plugin"],
  "iconKey": "blocks",
  "executionStyle": "action",
  "capability": "plugin_nodejs",
  "readiness": "any",
  "inputPorts": [{ "name": "main", "kind": "main", "required": true, "variadic": false }],
  "outputPorts": [{ "name": "main", "kind": "main", "required": false, "variadic": false }, { "name": "error", "kind": "error", "required": false, "variadic": false }],
  "bindingSlots": [],
  "parameterSchema": { "type": "object", "properties": { "label": { "type": "string" }, "includeMetadata": { "type": "boolean", "default": false }, "largeTrace": { "type": "boolean", "default": false } }, "required": ["label"], "additionalProperties": false },
  "outputSchema": { "type": "object", "additionalProperties": true },
  "outputPortSchemas": {},
  "outputCardinality": { "main": "many", "error": "many" },
  "selectorCapabilities": { "namespaces": ["inputs", "outputs", "contexts", "execution"], "supportsCurrent": true, "supportsFirstLast": true, "supportsAll": true, "supportsRunSelection": true },
  "contextReadCapability": true,
  "contextWriteCapability": true,
  "artifactOutputSchema": { "type": "array", "items": { "type": "object" } },
  "uiSchema": { "order": ["label", "includeMetadata", "largeTrace"], "fields": { "label": { "control": "text", "label": "Label" }, "includeMetadata": { "control": "boolean", "label": "Metadata output" }, "largeTrace": { "control": "boolean", "label": "Large trace artifact" } }, "canvas": { "role": "default" } },
  "providers": ["labels"],
  "credentials": [],
  "defaultTimeoutMs": 30000,
  "retryPolicy": { "retryable": false, "maxAttempts": 1, "initialBackoffMs": 0, "maxBackoffMs": 0 },
  "sandboxRequired": false,
  "supportsMock": true,
  "sideEffectLevel": "none"
}
