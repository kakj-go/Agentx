{
  "protocolVersion": 1,
  "sdkApiVersion": 1,
  "packageId": "acme/json-mapper",
  "packageVersion": "1.0.0",
  "displayName": "JSON Mapper",
  "description": "Maps input objects with a configurable label.",
  "nodes": ["nodes/json_mapper.json"],
  "runtimeEntry": "runtime/entry.js",
  "uiEntry": "ui/entry.js",
  "uiStylesEntry": "ui/styles.css",
  "uiAssets": { "logo": "ui/logo.svg" },
  "traceRenderers": [{
    "contentType": "acme.json-mapper/summary",
    "contentVersion": 1,
    "exportName": "summary",
    "schema": { "type": "object", "required": ["mapped"], "properties": { "mapped": { "type": "integer" } }, "additionalProperties": false }
  }, {
    "contentType": "acme.json-mapper/details",
    "contentVersion": 1,
    "exportName": "details",
    "schema": { "type": "object", "required": ["payload"], "properties": { "payload": { "type": "string" } }, "additionalProperties": false }
  }, {
    "contentType": "acme.json-mapper/table",
    "contentVersion": 1,
    "exportName": "table",
    "schema": { "type": "object", "required": ["columns", "rows"], "properties": { "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array" } } }, "additionalProperties": false }
  }]
}
