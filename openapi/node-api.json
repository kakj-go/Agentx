{
  "components": {
    "schemas": {
      "LifecycleRequest": {
        "$defs": {
          "LifecycleOperation": {
            "enum": [
              "activate",
              "deactivate",
              "poll",
              "webhook",
              "suspend",
              "resume"
            ],
            "type": "string"
          },
          "NodeProtocolVersion": {
            "enum": [
              "1.0"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "default": null
          },
          "nodeType": {
            "type": "string"
          },
          "nodeVersion": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "operation": {
            "$ref": "#/components/schemas/LifecycleRequest/$defs/LifecycleOperation"
          },
          "protocolVersion": {
            "$ref": "#/components/schemas/LifecycleRequest/$defs/NodeProtocolVersion"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "workflowVersionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "operation",
          "nodeType",
          "nodeVersion",
          "tenantId",
          "workflowVersionId"
        ],
        "title": "LifecycleRequest",
        "type": "object"
      },
      "LifecycleResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "state": {
            "default": null
          }
        },
        "required": [
          "accepted"
        ],
        "title": "LifecycleResponse",
        "type": "object"
      },
      "NodeActionRequest": {
        "$defs": {
          "BinaryReference": {
            "additionalProperties": false,
            "properties": {
              "artifactHandle": {
                "type": "string"
              },
              "contentType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fileName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sizeBytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "artifactHandle",
              "sizeBytes"
            ],
            "type": "object"
          },
          "ExecutionMode": {
            "enum": [
              "manual",
              "production",
              "evaluation",
              "partial"
            ],
            "type": "string"
          },
          "GroupedInput": {
            "additionalProperties": false,
            "properties": {
              "branchIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "items": {
                "items": {
                  "$ref": "#/components/schemas/NodeActionRequest/$defs/Item"
                },
                "type": "array"
              },
              "port": {
                "type": "string"
              }
            },
            "required": [
              "port",
              "branchIndex",
              "items"
            ],
            "type": "object"
          },
          "InvocationHandle": {
            "additionalProperties": false,
            "properties": {
              "brokerUrl": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              }
            },
            "required": [
              "handle",
              "brokerUrl",
              "expiresAt"
            ],
            "type": "object"
          },
          "Item": {
            "additionalProperties": false,
            "properties": {
              "binary": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/NodeActionRequest/$defs/BinaryReference"
                },
                "type": "object"
              },
              "json": true,
              "lineage": {
                "items": {
                  "$ref": "#/components/schemas/NodeActionRequest/$defs/ItemSource"
                },
                "type": "array"
              },
              "metadata": {
                "additionalProperties": true,
                "type": "object"
              }
            },
            "required": [
              "json"
            ],
            "type": "object"
          },
          "ItemSource": {
            "additionalProperties": false,
            "properties": {
              "itemIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "nodeExecutionId": {
                "format": "uuid",
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "outputIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "runIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "nodeExecutionId",
              "nodeId",
              "runIndex",
              "outputIndex",
              "itemIndex"
            ],
            "type": "object"
          },
          "NodeProtocolVersion": {
            "enum": [
              "1.0"
            ],
            "type": "string"
          },
          "ResolvedParameters": {
            "additionalProperties": false,
            "properties": {
              "common": true,
              "perItem": {
                "default": [],
                "items": true,
                "type": "array"
              }
            },
            "required": [
              "common"
            ],
            "type": "object"
          },
          "TraceContext": {
            "additionalProperties": false,
            "properties": {
              "spanId": {
                "type": "string"
              },
              "traceFlags": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "traceId": {
                "type": "string"
              }
            },
            "required": [
              "traceId",
              "spanId"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "artifactHandles": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NodeActionRequest/$defs/InvocationHandle"
            },
            "type": "array"
          },
          "attemptId": {
            "format": "uuid",
            "type": "string"
          },
          "cancellationUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "credentialHandles": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NodeActionRequest/$defs/InvocationHandle"
            },
            "type": "array"
          },
          "deadline": {
            "type": "string"
          },
          "executionId": {
            "format": "uuid",
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/NodeActionRequest/$defs/GroupedInput"
            },
            "type": "array"
          },
          "iterationIndex": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/NodeActionRequest/$defs/ExecutionMode"
          },
          "nodeExecutionId": {
            "format": "uuid",
            "type": "string"
          },
          "nodeType": {
            "type": "string"
          },
          "nodeVersion": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "parameters": {
            "$ref": "#/components/schemas/NodeActionRequest/$defs/ResolvedParameters"
          },
          "protocolVersion": {
            "$ref": "#/components/schemas/NodeActionRequest/$defs/NodeProtocolVersion"
          },
          "runIndex": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "traceContext": {
            "$ref": "#/components/schemas/NodeActionRequest/$defs/TraceContext"
          },
          "workflowVersionId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "nodeType",
          "nodeVersion",
          "tenantId",
          "workflowVersionId",
          "executionId",
          "nodeExecutionId",
          "attemptId",
          "runIndex",
          "iterationIndex",
          "mode",
          "inputs",
          "parameters",
          "idempotencyKey",
          "deadline",
          "traceContext"
        ],
        "title": "NodeActionRequest",
        "type": "object"
      },
      "NodeActionResult": {
        "$defs": {
          "BinaryReference": {
            "additionalProperties": false,
            "properties": {
              "artifactHandle": {
                "type": "string"
              },
              "contentType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fileName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sizeBytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "artifactHandle",
              "sizeBytes"
            ],
            "type": "object"
          },
          "Item": {
            "additionalProperties": false,
            "properties": {
              "binary": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/NodeActionResult/$defs/BinaryReference"
                },
                "type": "object"
              },
              "json": true,
              "lineage": {
                "items": {
                  "$ref": "#/components/schemas/NodeActionResult/$defs/ItemSource"
                },
                "type": "array"
              },
              "metadata": {
                "additionalProperties": true,
                "type": "object"
              }
            },
            "required": [
              "json"
            ],
            "type": "object"
          },
          "ItemSource": {
            "additionalProperties": false,
            "properties": {
              "itemIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "nodeExecutionId": {
                "format": "uuid",
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "outputIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "runIndex": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "nodeExecutionId",
              "nodeId",
              "runIndex",
              "outputIndex",
              "itemIndex"
            ],
            "type": "object"
          },
          "NodeProtocolError": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "default": null
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "type": "object"
          },
          "ProducedArtifact": {
            "additionalProperties": false,
            "properties": {
              "artifactHandle": {
                "type": "string"
              },
              "contentType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "sizeBytes": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "artifactHandle",
              "sizeBytes"
            ],
            "type": "object"
          },
          "ResumeContract": {
            "additionalProperties": false,
            "properties": {
              "allowedOutputPorts": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "$ref": "#/components/schemas/NodeActionResult/$defs/ResumeKind"
              },
              "payloadSchema": true,
              "timeoutAt": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "allowedOutputPorts",
              "payloadSchema"
            ],
            "type": "object"
          },
          "ResumeKind": {
            "enum": [
              "time",
              "webhook",
              "form",
              "approval"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "properties": {
              "artifacts": {
                "default": [],
                "items": {
                  "$ref": "#/components/schemas/NodeActionResult/$defs/ProducedArtifact"
                },
                "type": "array"
              },
              "outputs": {
                "items": {
                  "items": {
                    "$ref": "#/components/schemas/NodeActionResult/$defs/Item"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "status": {
                "const": "completed",
                "type": "string"
              }
            },
            "required": [
              "status",
              "outputs"
            ],
            "type": "object"
          },
          {
            "properties": {
              "error": {
                "$ref": "#/components/schemas/NodeActionResult/$defs/NodeProtocolError"
              },
              "status": {
                "const": "failed",
                "type": "string"
              }
            },
            "required": [
              "status",
              "error"
            ],
            "type": "object"
          },
          {
            "properties": {
              "checkpoint": {
                "default": null
              },
              "resume": {
                "$ref": "#/components/schemas/NodeActionResult/$defs/ResumeContract"
              },
              "status": {
                "const": "suspended",
                "type": "string"
              }
            },
            "required": [
              "status",
              "resume"
            ],
            "type": "object"
          }
        ],
        "title": "NodeActionResult"
      },
      "NodeProtocolError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "default": null
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "NodeProtocolError",
        "type": "object"
      },
      "ProviderRequest": {
        "$defs": {
          "InvocationHandle": {
            "additionalProperties": false,
            "properties": {
              "brokerUrl": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              }
            },
            "required": [
              "handle",
              "brokerUrl",
              "expiresAt"
            ],
            "type": "object"
          },
          "NodeProtocolVersion": {
            "enum": [
              "1.0"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "credentialHandles": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ProviderRequest/$defs/InvocationHandle"
            },
            "type": "array"
          },
          "operation": {
            "type": "string"
          },
          "parameters": {
            "default": null
          },
          "protocolVersion": {
            "$ref": "#/components/schemas/ProviderRequest/$defs/NodeProtocolVersion"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "provider",
          "operation"
        ],
        "title": "ProviderRequest",
        "type": "object"
      },
      "ProviderResponse": {
        "$defs": {
          "ProviderOption": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "metadata": {
                "default": null
              },
              "value": true
            },
            "required": [
              "label",
              "value"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ProviderResponse/$defs/ProviderOption"
            },
            "type": "array"
          }
        },
        "required": [
          "options"
        ],
        "title": "ProviderResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Agentx Node Protocol",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agentx/node/v1/actions/execute": {
      "post": {
        "operationId": "executeNodeAction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeActionResult"
                }
              }
            },
            "description": "Node result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeProtocolError"
                }
              }
            },
            "description": "Invalid protocol request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeProtocolError"
                }
              }
            },
            "description": "Authentication failed"
          }
        }
      }
    },
    "/agentx/node/v1/lifecycle/{operation}": {
      "post": {
        "operationId": "invokeNodeLifecycle",
        "parameters": [
          {
            "in": "path",
            "name": "operation",
            "required": true,
            "schema": {
              "enum": [
                "activate",
                "deactivate",
                "poll",
                "webhook",
                "suspend",
                "resume"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifecycleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LifecycleResponse"
                }
              }
            },
            "description": "Lifecycle result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeProtocolError"
                }
              }
            },
            "description": "Invalid lifecycle request"
          }
        }
      }
    },
    "/agentx/node/v1/providers/{provider}/invoke": {
      "post": {
        "operationId": "invokeNodeProvider",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            },
            "description": "Provider options"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeProtocolError"
                }
              }
            },
            "description": "Invalid provider request"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
