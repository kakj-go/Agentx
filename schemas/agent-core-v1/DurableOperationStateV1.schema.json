{
  "$defs": {
    "DurableOperationPhaseV1": {
      "enum": [
        "accepted",
        "checkpoint",
        "model_ready",
        "model_effect_pending",
        "model_settled",
        "tool_batch_planned",
        "tool_effect_pending",
        "tool_settled",
        "compaction_planned",
        "compaction_effect_pending",
        "compaction_settled",
        "terminal",
        "pending",
        "cancelled",
        "unknown_outcome"
      ],
      "type": "string"
    },
    "ReplayPolicyV1": {
      "enum": [
        "safe",
        "never",
        "idempotency_required",
        "ledger_dependent"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "type": "string"
    },
    "bundleHash": {
      "type": "string"
    },
    "continuation": true,
    "deadlineAtMillis": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "effectIdentity": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectedStateVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "fencingToken": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "inputHash": {
      "type": "string"
    },
    "modelVersion": {
      "type": "string"
    },
    "operationId": {
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/DurableOperationPhaseV1"
    },
    "recoveryAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "registryHash": {
      "type": "string"
    },
    "replayPolicy": {
      "$ref": "#/$defs/ReplayPolicyV1"
    },
    "updatedAtMillis": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "operationId",
    "attemptId",
    "fencingToken",
    "expectedStateVersion",
    "phase",
    "inputHash",
    "bundleHash",
    "modelVersion",
    "registryHash",
    "replayPolicy",
    "deadlineAtMillis",
    "updatedAtMillis"
  ],
  "title": "DurableOperationStateV1",
  "type": "object"
}
