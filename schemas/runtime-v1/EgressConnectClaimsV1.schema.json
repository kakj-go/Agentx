      ],
      "type": "string"
    },
    "EgressRole": {
      "enum": [
        "runtime-gateway",
        "workflow-runtime",
        "workflow-worker",
        "sandbox"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
