    },
    "createdAt": {
      "type": "string"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": true,
    "iterationIndex": {
      "format": "uint32",
