      "type": "integer"
    },
    "nodeExecutionId": {
      "format": "uuid",
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "nodeName": {
      "type": "string"
    },
    "nodeType": {
      "type": "string"
    },
    "nodeVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "output": true,
    "runIndex": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "nodeExecutionId",
    "nodeId",
    "nodeName",
    "nodeType",
    "nodeVersion",
    "runIndex",
    "iterationIndex",
    "status",
