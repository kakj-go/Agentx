{
  "$defs": {
    "ContextDefinition": {
      "additionalProperties": false,
      "properties": {
        "clientWritable": {
          "default": false,
          "type": "boolean"
        },
        "default": {
          "default": null
        },
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "maxSize": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mergePolicy": {
          "$ref": "#/$defs/ContextMergePolicy",
          "default": "replace"
        },
        "mutable": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "default": null
        },
        "scope": {
          "$ref": "#/$defs/ContextScope",
          "default": "execution_tree"
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        },
        "title": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ContextMergePolicy": {
      "enum": [
        "replace",
        "append",
        "merge_object",
        "increment",
        "reject_conflict"
      ],
      "type": "string"
    },
    "ContextScope": {
      "enum": [
        "execution_tree",
        "session"
      ],
      "type": "string"
    },
    "ContextWrite": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "$ref": "#/$defs/ContextWriteOperation"
        },
        "path": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "operation",
        "path",
        "value"
      ],
      "type": "object"
    },
    "ContextWriteOperation": {
      "enum": [
        "set",
        "set_if_absent",
        "delete",
        "append",
        "merge_object",
        "increment",
        "min",
        "max",
        "compare_and_set"
      ],
      "type": "string"
    },
    "EndErrorStrategy": {
      "enum": [
        "fail_fast",
        "collect"
      ],
      "type": "string"
    },
    "ExecutionOrder": {
      "enum": [
        "deterministic",
        "parallel"
      ],
      "type": "string"
    },
    "NodeErrorPolicy": {
      "enum": [
        "stop_workflow",
        "continue_regular_output",
        "continue_error_output"
      ],
      "type": "string"
    },
    "NodeSettings": {
      "additionalProperties": false,
      "properties": {
        "alwaysOutputData": {
          "default": false,
          "type": "boolean"
        },
        "executeOnce": {
          "default": false,
          "type": "boolean"
        },
        "maxTries": {
          "default": 1,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "onError": {
          "$ref": "#/$defs/NodeErrorPolicy",
          "default": "stop_workflow"
        },
        "retryOnFail": {
          "default": false,
          "type": "boolean"
        },
        "timeoutMs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "waitBetweenTriesMs": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OutputProjectionField": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        },
        "schema": {
          "default": null
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "expression"
      ],
      "type": "object"
    },
    "ResourceOperation": {
      "enum": [
        "view",
        "use",
        "read",
        "write",
        "manage"
      ],
      "type": "string"
    },
    "ResourceReference": {
      "properties": {
        "bindingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindingRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "$ref": "#/$defs/ResourceOperation"
        },
        "resourceId": {
          "format": "uuid",
          "type": "string"
        },
        "resourceType": {
          "$ref": "#/$defs/ResourceType"
        },
        "resourceVersionId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "operation"
      ],
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "credential",
        "model",
        "mcp_server",
        "mcp_tool",
        "skill",
        "rag",
        "memory",
        "sandbox_profile"
      ],
      "type": "string"
    },
    "WorkflowConnection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sourceHandle": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": "string"
        },
        "targetHandle": {
          "type": "string"
        },
        "targetNodeId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceNodeId",
        "sourceHandle",
        "targetNodeId",
        "targetHandle",
        "order"
      ],
      "type": "object"
    },
    "WorkflowEnd": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/WorkflowErrorEnd",
          "default": {
            "collectWindowMs": 5000,
            "outputs": {},
            "strategy": "fail_fast"
          }
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowOutput"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "WorkflowErrorEnd": {
      "additionalProperties": false,
      "properties": {
        "collectWindowMs": {
          "default": 5000,
          "format": "uint64",
          "maximum": 60000,
          "minimum": 100,
          "type": "integer"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowOutput"
          },
          "default": {},
          "type": "object"
        },
        "strategy": {
          "$ref": "#/$defs/EndErrorStrategy",
          "default": "fail_fast"
        }
      },
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": false,
      "properties": {
        "contextWrites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextWrite"
          },
          "type": "array"
        },
        "disabled": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outputProjection": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/OutputProjectionField"
            },
            "type": "object"
          },
          "default": {},
          "type": "object"
        },
        "parameters": {
          "default": null
        },
        "resourceReferences": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceReference"
          },
          "type": "array"
        },
        "settings": {
          "$ref": "#/$defs/NodeSettings",
          "default": {
            "alwaysOutputData": false,
            "executeOnce": false,
            "maxTries": 1,
            "onError": "stop_workflow",
            "retryOnFail": false,
            "timeoutMs": null,
            "waitBetweenTriesMs": 0
          }
        },
        "type": {
          "type": "string"
        },
        "typeVersion": {
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "key",
        "type",
        "typeVersion",
        "name"
      ],
      "type": "object"
    },
    "WorkflowOutput": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "default": null
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "expression"
      ],
      "type": "object"
    },
    "WorkflowSchemaVersion": {
      "enum": [
        "4.0"
      ],
      "type": "string"
    },
    "WorkflowSettings": {
      "additionalProperties": false,
      "properties": {
        "activationBudget": {
          "default": 10000,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "executionOrder": {
          "$ref": "#/$defs/ExecutionOrder",
          "default": "deterministic"
        },
        "timeoutMs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkflowStart": {
      "additionalProperties": false,
      "properties": {
        "contexts": {
          "additionalProperties": {
            "$ref": "#/$defs/ContextDefinition"
          },
          "default": {},
          "type": "object"
        },
        "inputs": {
          "default": null
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connections": {
      "items": {
        "$ref": "#/$defs/WorkflowConnection"
      },
      "type": "array"
    },
    "end": {
      "$ref": "#/$defs/WorkflowEnd"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "type": "array"
    },
    "schemaVersion": {
      "$ref": "#/$defs/WorkflowSchemaVersion"
    },
    "settings": {
      "$ref": "#/$defs/WorkflowSettings",
      "default": {
        "activationBudget": 10000,
        "executionOrder": "deterministic",
        "timeoutMs": null
      }
    },
    "start": {
      "$ref": "#/$defs/WorkflowStart"
    }
  },
  "required": [
    "schemaVersion",
    "start",
    "nodes",
    "connections",
    "end"
  ],
  "title": "WorkflowDefinition",
  "type": "object"
}
