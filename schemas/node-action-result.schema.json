{
  "$defs": {
    "BinaryReference": {
      "additionalProperties": false,
      "properties": {
        "artifactHandle": {
          "type": "string"
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "fileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifactHandle",
        "sizeBytes"
      ],
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "additionalProperties": {
            "$ref": "#/$defs/BinaryReference"
          },
          "type": "object"
        },
        "json": true,
        "lineage": {
          "items": {
            "$ref": "#/$defs/ItemSource"
          },
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "json"
      ],
      "type": "object"
    },
    "ItemSource": {
      "additionalProperties": false,
      "properties": {
        "itemIndex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "nodeExecutionId": {
          "format": "uuid",
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "outputIndex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runIndex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "nodeExecutionId",
        "nodeId",
        "runIndex",
        "outputIndex",
        "itemIndex"
      ],
      "type": "object"
    },
    "NodeProtocolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "default": null
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "ProducedArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifactHandle": {
          "type": "string"
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "artifactHandle",
        "sizeBytes"
      ],
      "type": "object"
    },
    "ResumeContract": {
      "additionalProperties": false,
      "properties": {
        "allowedOutputPorts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ResumeKind"
        },
        "payloadSchema": true,
        "timeoutAt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "allowedOutputPorts",
        "payloadSchema"
      ],
      "type": "object"
    },
    "ResumeKind": {
      "enum": [
        "time",
        "webhook",
        "form",
        "approval"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProducedArtifact"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "items": {
              "$ref": "#/$defs/Item"
            },
            "type": "array"
          },
          "type": "array"
        },
        "status": {
          "const": "completed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "outputs"
      ],
      "type": "object"
    },
    {
      "properties": {
        "error": {
          "$ref": "#/$defs/NodeProtocolError"
        },
        "status": {
          "const": "failed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "error"
      ],
      "type": "object"
    },
    {
      "properties": {
        "checkpoint": {
          "default": null
        },
        "resume": {
          "$ref": "#/$defs/ResumeContract"
        },
        "status": {
          "const": "suspended",
          "type": "string"
        }
      },
      "required": [
        "status",
        "resume"
      ],
      "type": "object"
    }
  ],
  "title": "NodeActionResult"
}
